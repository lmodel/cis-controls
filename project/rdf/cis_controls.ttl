	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	skos:prefLabel "cis_controls" ;
	linkml:description "The Controls, in CIS's order." ;
	linkml:domain_of <https://w3id.org/lmodel/cis-controls/CisControls> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:minimum_cardinality 1 ;
