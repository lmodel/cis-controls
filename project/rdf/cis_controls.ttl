	linkml:owner <https://w3id.org/lmodel/cis-controls/CisControls> ;
	linkml:range <https://w3id.org/lmodel/cis-controls/CisControl> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/cis-controls/cis_controls"^^xsd:anyURI .
<https://w3id.org/lmodel/cis-controls/cisControls__cis_version> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	skos:prefLabel "cis_version" ;
	linkml:description "The edition, as CIS numbers it, such as 8.1, or the revision the guide's pages carry, such as 8.1.2." ;
	linkml:domain_of <https://w3id.org/lmodel/cis-controls/CisControls> ;
	linkml:owner <https://w3id.org/lmodel/cis-controls/CisControls> ;
	linkml:pattern "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" ;
	linkml:range <https://w3id.org/lmodel/cis-controls/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/cis-controls/cis_version"^^xsd:anyURI .
<https://w3id.org/lmodel/cis-controls/cisSafeguard__safeguard_asset_class> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	skos:prefLabel "safeguard_asset_class" ;
	linkml:description "The class of enterprise asset the Safeguard is about." ;
	linkml:domain_of <https://w3id.org/lmodel/cis-controls/CisSafeguard> ;
	linkml:owner <https://w3id.org/lmodel/cis-controls/CisSafeguard> ;
	linkml:range <https://w3id.org/lmodel/cis-controls/CisAssetClass> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/cis-controls/safeguard_asset_class"^^xsd:anyURI .
<https://w3id.org/lmodel/cis-controls/cisSafeguard__safeguard_implementation_groups> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	skos:note "The groups are cumulative: a Safeguard in IG1 is in IG2 and IG3 too, and one in IG2 is in IG3. The schema states the part of that rule the validator can check, that every Safeguard is in IG3. The JSON Schema that LinkML 1.12.1 generates drops the rest, so a list of IG1 and IG3 without IG2 passes the validator. tests/test_data.py checks the whole rule over the examples." ;
	skos:prefLabel "safeguard_implementation_groups" ;
	linkml:description "The Implementation Groups that include the Safeguard." ;
	linkml:domain_of <https://w3id.org/lmodel/cis-controls/CisSafeguard> ;
	linkml:has_member _:c14n17 ;
	linkml:maximum_cardinality 3 ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/cis-controls/CisSafeguard> ;
	linkml:range <https://w3id.org/lmodel/cis-controls/CisImplementationGroup> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/cis-controls/safeguard_implementation_groups"^^xsd:anyURI .
<https://w3id.org/lmodel/cis-controls/cisSafeguard__safeguard_security_function> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	skos:prefLabel "safeguard_security_function" ;
	linkml:description "The security function the Safeguard serves, one of the six functions of the NIST Cybersecurity Framework (CSF) 2.0." ;
	linkml:domain_of <https://w3id.org/lmodel/cis-controls/CisSafeguard> ;
	linkml:owner <https://w3id.org/lmodel/cis-controls/CisSafeguard> ;
	linkml:range <https://w3id.org/lmodel/cis-controls/CisSecurityFunction> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/cis-controls/safeguard_security_function"^^xsd:anyURI .
<https://w3id.org/lmodel/cis-controls/cis_control_id> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	skos:note "The identifier is CIS's own number, so data joins with CIS's guide and with the crosswalks that cite it without a translation. It is a string, so quote it in YAML: YAML reads an unquoted 4 as a number and an unquoted 1.10 as the number 1.1. The validator rejects either as not a string, but a file loaded into the generated dataclasses without validation would turn 1.10 into 1.1." ;
	linkml:definition_uri "https://w3id.org/lmodel/cis-controls/cis_control_id"^^xsd:anyURI ;
	linkml:description "The Control's identifier, its number, such as 4." ;
	linkml:domain_of <https://w3id.org/lmodel/cis-controls/CisControl> ;
	linkml:owner <https://w3id.org/lmodel/cis-controls/CisControl> ;
	linkml:range <https://w3id.org/lmodel/cis-controls/cis_control_identifier> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/cis-controls/cis_control_id"^^xsd:anyURI .
<https://w3id.org/lmodel/cis-controls/cis_control_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cis-controls/CisControlIdentifier"^^xsd:anyURI ;
	linkml:description "A Control's identifier: its number from 1 to 18, as CIS writes it, such as 4 for Control 4." ;
	linkml:pattern "^([1-9]|1[0-8])$" ;
	linkml:typeof <https://w3id.org/lmodel/cis-controls/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cis-controls/cis_controls> dcterms:license "Apache-2.0" ;
	dcterms:source "https://www.cisecurity.org/controls/v8-1"^^xsd:anyURI ;
	dcterms:title "CIS Critical Security Controls" ;
	pav:version "8.1.2" ;
	a linkml:SchemaDefinition , linkml:SlotDefinition ;
	rdfs:seeAlso "https://lmodel.github.io/cis-controls"^^xsd:anyURI , "https://www.cisecurity.org/controls/cis-controls-list"^^xsd:anyURI , "https://www.cisecurity.org/controls/implementation-groups"^^xsd:anyURI , "https://www.cisecurity.org/insights/white-papers/guide-to-asset-classes-cis-critical-security-controls-v8-1"^^xsd:anyURI ;
	skos:note "CIS licenses the CIS Controls under CC BY-NC-ND 4.0 and requires its prior approval for commercial use, while this schema is Apache-2.0. So the schema carries no CIS text: none of the guide's titles, descriptions, overviews or explanations. The descriptions here are this project's own words, and so are the title and description that src/cis_controls/data/cis-controls-8.1.2.yaml gives each Control and Safeguard, written from what each requires. The text slots, title and description, are optional and hold text their user has the right to use; NOTICE states the position." , "The edition holds 18 Controls and 153 Safeguards. Implementation Group 1 holds 56 of the Safeguards, Implementation Group 2 adds 74 to make 130, and Implementation Group 3 adds the last 23, so it holds all 153. CIS's pages on the CIS Controls list and on each Implementation Group state these numbers." , "The version is the label that the pages of CIS's guide carry for its revision of March 2025. CIS's site calls the edition Version 8.1. The guide's change log names two minor revisions of it, v8.1.1 in August 2024 and v8.1.2 in March 2025. They corrected small errors, among them the security function of two Safeguards. The source is CIS's page for Version 8.1. scripts/check_upstream_release.py holds the same pins and reports when CIS's pages name a newer version." ;
	sh:declare _:c14n0 , _:c14n11 , _:c14n18 , _:c14n2 , _:c14n6 , _:c14n8 ;
	linkml:annotations _:c14n14 , _:c14n3 , _:c14n5 ;
	linkml:classes <https://w3id.org/lmodel/cis-controls/CisControl> , <https://w3id.org/lmodel/cis-controls/CisControls> , <https://w3id.org/lmodel/cis-controls/CisSafeguard> ;
	linkml:default_prefix "cis_controls" ;
	linkml:default_range <https://w3id.org/lmodel/cis-controls/string> ;
	linkml:description "A LinkML model of the structure of the CIS Critical Security Controls (CIS Controls), Version 8.1, which the Center for Internet Security (CIS) publishes. It models the Controls and the Safeguards of each Control. For each Safeguard it records the asset class, the security function and the Implementation Groups that include it. It names each Control and Safeguard by its number and carries none of CIS's text." , "The Controls, in CIS's order." ;
	linkml:enums <https://w3id.org/lmodel/cis-controls/CisAssetClass> , <https://w3id.org/lmodel/cis-controls/CisImplementationGroup> , <https://w3id.org/lmodel/cis-controls/CisSecurityFunction> ;
	linkml:id "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	linkml:imports "linkml:types"^^xsd:anyURI ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:metamodel_version "1.12.0" ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cis-controls/CisControl> ;
	linkml:required true ;
	linkml:slots <https://w3id.org/lmodel/cis-controls/cisControl__control_safeguards> , <https://w3id.org/lmodel/cis-controls/cisControls__cis_controls> , <https://w3id.org/lmodel/cis-controls/cisControls__cis_version> , <https://w3id.org/lmodel/cis-controls/cisSafeguard__safeguard_asset_class> , <https://w3id.org/lmodel/cis-controls/cisSafeguard__safeguard_implementation_groups> , <https://w3id.org/lmodel/cis-controls/cisSafeguard__safeguard_security_function> , <https://w3id.org/lmodel/cis-controls/cis_control_id> , <https://w3id.org/lmodel/cis-controls/cis_safeguard_id> , <https://w3id.org/lmodel/cis-controls/description> , <https://w3id.org/lmodel/cis-controls/title> ;
	linkml:source_file "cis_controls.yaml" ;
	linkml:source_file_date "2026-11-07T02:03:56"^^xsd:dateTime ;
	linkml:source_file_size 12458 ;
	linkml:types <https://w3id.org/lmodel/cis-controls/boolean> , <https://w3id.org/lmodel/cis-controls/cis_control_identifier> , <https://w3id.org/lmodel/cis-controls/cis_safeguard_identifier> , <https://w3id.org/lmodel/cis-controls/curie> , <https://w3id.org/lmodel/cis-controls/date> , <https://w3id.org/lmodel/cis-controls/date_or_datetime> , <https://w3id.org/lmodel/cis-controls/datetime> , <https://w3id.org/lmodel/cis-controls/decimal> , <https://w3id.org/lmodel/cis-controls/double> , <https://w3id.org/lmodel/cis-controls/float> , <https://w3id.org/lmodel/cis-controls/integer> , <https://w3id.org/lmodel/cis-controls/jsonpath> , <https://w3id.org/lmodel/cis-controls/jsonpointer> , <https://w3id.org/lmodel/cis-controls/ncname> , <https://w3id.org/lmodel/cis-controls/nodeidentifier> , <https://w3id.org/lmodel/cis-controls/objectidentifier> , <https://w3id.org/lmodel/cis-controls/sparqlpath> , <https://w3id.org/lmodel/cis-controls/string> , <https://w3id.org/lmodel/cis-controls/time> , <https://w3id.org/lmodel/cis-controls/uri> , <https://w3id.org/lmodel/cis-controls/uriorcurie> .
<https://w3id.org/lmodel/cis-controls/cis_safeguard_id> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	skos:note "It starts with the number of the Control that holds the Safeguard. The validator cannot check that against the Control a Safeguard is listed under; tests/test_data.py checks it over the examples." ;
	linkml:definition_uri "https://w3id.org/lmodel/cis-controls/cis_safeguard_id"^^xsd:anyURI ;
	linkml:description "The Safeguard's identifier, its number, such as 4.1." ;
	linkml:domain_of <https://w3id.org/lmodel/cis-controls/CisSafeguard> ;
	linkml:owner <https://w3id.org/lmodel/cis-controls/CisSafeguard> ;
	linkml:range <https://w3id.org/lmodel/cis-controls/cis_safeguard_identifier> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/cis-controls/cis_safeguard_id"^^xsd:anyURI .
<https://w3id.org/lmodel/cis-controls/cis_safeguard_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cis-controls/CisSafeguardIdentifier"^^xsd:anyURI ;
	linkml:description "A Safeguard's identifier, as CIS writes it: the number of its Control, a dot and the Safeguard's number within the Control, such as 4.1 for Safeguard 4.1." ;
	linkml:pattern "^([1-9]|1[0-8])\\.[1-9][0-9]?$" ;
	linkml:typeof <https://w3id.org/lmodel/cis-controls/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cis-controls/cis_version> a linkml:SlotDefinition ;
	linkml:description "The edition, as CIS numbers it, such as 8.1, or the revision the guide's pages carry, such as 8.1.2." ;
	linkml:pattern "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" ;
	linkml:required true .
<https://w3id.org/lmodel/cis-controls/control_safeguards> a linkml:SlotDefinition ;
	linkml:description "The Safeguards of the Control. A knowledge bundle relates a Safeguard to its Control with isPartOf instead." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cis-controls/CisSafeguard> .
