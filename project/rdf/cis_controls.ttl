<https://w3id.org/lmodel/cis-controls/title> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/name"^^xsd:anyURI ;
	skos:note "CIS's own names for the Controls and Safeguards are CIS's text under CC BY-NC-ND 4.0, so the schema's examples leave them out, and the edition file names each element in this project's words." , "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." ;
	linkml:definition_uri "https://w3id.org/lmodel/cis-controls/title"^^xsd:anyURI ;
	linkml:description "A name for the Control or Safeguard, in words its user has the right to use." ;
	linkml:domain_of <https://w3id.org/lmodel/cis-controls/CisControl> , <https://w3id.org/lmodel/cis-controls/CisSafeguard> ;
	linkml:owner <https://w3id.org/lmodel/cis-controls/CisSafeguard> ;
	linkml:range <https://w3id.org/lmodel/cis-controls/string> ;
	linkml:slot_uri "http://schema.org/name"^^xsd:anyURI .
