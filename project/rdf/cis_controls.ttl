<https://w3id.org/lmodel/cis-controls/CisAssetClass> rdfs:seeAlso "https://www.cisecurity.org/insights/white-papers/guide-to-asset-classes-cis-critical-security-controls-v8-1"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	skos:note "CIS revised the classes, and which Safeguard is about which, in Version 8.1. CIS's guide divides each class further, but a Safeguard names only the class." ;
	linkml:definition_uri "https://w3id.org/lmodel/cis-controls/CisAssetClass"^^xsd:anyURI ;
	linkml:description "One of the classes of enterprise asset that the CIS Controls sort their Safeguards by. Each Safeguard is about one class." ;
	linkml:permissible_values <https://w3id.org/lmodel/cis-controls/DATA> , <https://w3id.org/lmodel/cis-controls/DEVICES> , <https://w3id.org/lmodel/cis-controls/DOCUMENTATION> , <https://w3id.org/lmodel/cis-controls/NETWORK> , <https://w3id.org/lmodel/cis-controls/SOFTWARE> , <https://w3id.org/lmodel/cis-controls/USERS> .
<https://w3id.org/lmodel/cis-controls/CisControl> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://www.cisecurity.org/controls/cis-controls-list"^^xsd:anyURI ;
	skos:broadMatch "oscal:Group"^^xsd:anyURI ;
	skos:exactMatch "cis_controls:Control"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/cis-controls/control_safeguards> ;
	linkml:class_uri "https://w3id.org/lmodel/cis-controls/Control"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/cis-controls/CisControl"^^xsd:anyURI ;
	linkml:description "One of the CIS Controls: a group of Safeguards on one subject, named by its number, such as Control 4." ;
	linkml:slot_usage _:c14n7 ;
	linkml:slots <https://w3id.org/lmodel/cis-controls/cisControl__control_safeguards> , <https://w3id.org/lmodel/cis-controls/cis_control_id> , <https://w3id.org/lmodel/cis-controls/description> , <https://w3id.org/lmodel/cis-controls/title> .
<https://w3id.org/lmodel/cis-controls/CisControls> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://www.cisecurity.org/controls/cis-controls-list"^^xsd:anyURI ;
	skos:broadMatch "oscal:Catalog"^^xsd:anyURI ;
	skos:exactMatch "cis_controls:Controls"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/cis-controls/cis_controls> , <https://w3id.org/lmodel/cis-controls/cis_version> ;
	linkml:class_uri "https://w3id.org/lmodel/cis-controls/Controls"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/cis-controls/CisControls"^^xsd:anyURI ;
	linkml:description "One edition of the CIS Controls as a whole: its Controls, each holding its Safeguards." ;
	linkml:slot_usage _:c14n9 ;
	linkml:slots <https://w3id.org/lmodel/cis-controls/cisControls__cis_controls> , <https://w3id.org/lmodel/cis-controls/cisControls__cis_version> ;
	linkml:tree_root true .
<https://w3id.org/lmodel/cis-controls/CisImplementationGroup> rdfs:seeAlso "https://www.cisecurity.org/controls/implementation-groups"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/cis-controls/CisImplementationGroup"^^xsd:anyURI ;
	linkml:description "One of the three Implementation Groups, CIS's tiers for deciding which Safeguards an enterprise puts in place first. Each group includes every Safeguard of the groups before it." ;
	linkml:permissible_values <https://w3id.org/lmodel/cis-controls/IG1> , <https://w3id.org/lmodel/cis-controls/IG2> , <https://w3id.org/lmodel/cis-controls/IG3> .
<https://w3id.org/lmodel/cis-controls/CisSafeguard> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://www.cisecurity.org/controls/cis-controls-list"^^xsd:anyURI ;
	skos:broadMatch "oscal:Control"^^xsd:anyURI ;
	skos:exactMatch "cis_controls:Safeguard"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/cis-controls/safeguard_asset_class> , <https://w3id.org/lmodel/cis-controls/safeguard_implementation_groups> , <https://w3id.org/lmodel/cis-controls/safeguard_security_function> ;
	linkml:class_uri "https://w3id.org/lmodel/cis-controls/Safeguard"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/cis-controls/CisSafeguard"^^xsd:anyURI ;
	linkml:description "One Safeguard of a Control: a single action an enterprise takes, named by its Control's number and its own, such as Safeguard 4.1." ;
	linkml:slot_usage _:c14n12 ;
	linkml:slots <https://w3id.org/lmodel/cis-controls/cisSafeguard__safeguard_asset_class> , <https://w3id.org/lmodel/cis-controls/cisSafeguard__safeguard_implementation_groups> , <https://w3id.org/lmodel/cis-controls/cisSafeguard__safeguard_security_function> , <https://w3id.org/lmodel/cis-controls/cis_safeguard_id> , <https://w3id.org/lmodel/cis-controls/description> , <https://w3id.org/lmodel/cis-controls/title> .
<https://w3id.org/lmodel/cis-controls/CisSecurityFunction> rdfs:seeAlso "https://www.cisecurity.org/controls/v8-1"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cis-controls"^^xsd:anyURI ;
	skos:note "lmodel/nist-csf-v2 v0.1.0 models a CSF function as an instance of its class CsfFunction, IRI nist_csf_v2:Function, named by the two letters in its csf_function_id. It publishes no IRI for each function, so the values carry no meaning; each value's csf_function_id annotation gives the letters, and the enum names the class in related_mappings." ;
	skos:relatedMatch "nist_csf_v2:Function"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/cis-controls/CisSecurityFunction"^^xsd:anyURI ;
	linkml:description "The security function a Safeguard serves. The values are the six functions of the NIST Cybersecurity Framework (CSF) 2.0, to which Version 8.1 aligned the CIS Controls." ;
	linkml:permissible_values <https://w3id.org/lmodel/cis-controls/DETECT> , <https://w3id.org/lmodel/cis-controls/GOVERN> , <https://w3id.org/lmodel/cis-controls/IDENTIFY> , <https://w3id.org/lmodel/cis-controls/PROTECT> , <https://w3id.org/lmodel/cis-controls/RECOVER> , <https://w3id.org/lmodel/cis-controls/RESPOND> .
<https://w3id.org/lmodel/cis-controls/DATA> dcterms:title "Data" ;
	linkml:description "The information the enterprise holds, uses and moves." .
<https://w3id.org/lmodel/cis-controls/DETECT> dcterms:title "Detect" ;
	linkml:annotations _:c14n19 ;
	linkml:description "The CSF 2.0 function DETECT." .
<https://w3id.org/lmodel/cis-controls/DEVICES> dcterms:title "Devices" ;
	linkml:description "The enterprise's hardware, wherever it runs." .
<https://w3id.org/lmodel/cis-controls/DOCUMENTATION> dcterms:title "Documentation" ;
	linkml:description "The enterprise's written governance, such as its policies and procedures." .
<https://w3id.org/lmodel/cis-controls/GOVERN> dcterms:title "Govern" ;
	linkml:annotations _:c14n13 ;
	linkml:description "The CSF 2.0 function GOVERN." .
<https://w3id.org/lmodel/cis-controls/IDENTIFY> dcterms:title "Identify" ;
	linkml:annotations _:c14n15 ;
	linkml:description "The CSF 2.0 function IDENTIFY." .
<https://w3id.org/lmodel/cis-controls/IG1> dcterms:title "Implementation Group 1" ;
	linkml:description "The first group, where every enterprise starts." .
<https://w3id.org/lmodel/cis-controls/IG2> dcterms:title "Implementation Group 2" ;
	linkml:description "The second group, which adds Safeguards to the first." .
<https://w3id.org/lmodel/cis-controls/IG3> dcterms:title "Implementation Group 3" ;
	linkml:description "The third group, which adds the rest and so holds every Safeguard." .
<https://w3id.org/lmodel/cis-controls/NETWORK> dcterms:title "Network" ;
	linkml:description "How the enterprise's devices connect, and how its networks are laid out." .
<https://w3id.org/lmodel/cis-controls/PROTECT> dcterms:title "Protect" ;
	linkml:annotations _:c14n4 ;
	linkml:description "The CSF 2.0 function PROTECT." .
<https://w3id.org/lmodel/cis-controls/RECOVER> dcterms:title "Recover" ;
	linkml:annotations _:c14n1 ;
	linkml:description "The CSF 2.0 function RECOVER." .
<https://w3id.org/lmodel/cis-controls/RESPOND> dcterms:title "Respond" ;
	linkml:annotations _:c14n16 ;
	linkml:description "The CSF 2.0 function RESPOND." .
<https://w3id.org/lmodel/cis-controls/SOFTWARE> dcterms:title "Software" ;
	linkml:description "The programs and systems that run on the enterprise's devices." .
<https://w3id.org/lmodel/cis-controls/USERS> dcterms:title "Users" ;
	linkml:description "The people and accounts with access to the enterprise's assets." .
<https://w3id.org/lmodel/cis-controls/boolean> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"." ;
	skos:exactMatch "schema:Boolean"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Bool" ;
	linkml:definition_uri "https://w3id.org/linkml/Boolean"^^xsd:anyURI ;
