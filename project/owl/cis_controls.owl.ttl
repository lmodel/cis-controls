@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix cis_controls: <https://w3id.org/lmodel/cis-controls/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix nist_csf_v2: <https://w3id.org/lmodel/nist-csf-v2/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix oscal: <https://w3id.org/lmodel/oscal/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
xsd:string a rdfs:Datatype ;
	owl:equivalentClass _:c14n56 , _:c14n58 .
<https://w3id.org/lmodel/cis-controls.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://www.cisecurity.org/controls/v8-1> ;
	dcterms:title "CIS Critical Security Controls" ;
	pav:version "8.1.2" ;
	a owl:Ontology ;
	rdfs:label "cis_controls" ;
	rdfs:seeAlso <https://lmodel.github.io/cis-controls> , <https://www.cisecurity.org/controls/cis-controls-list> , <https://www.cisecurity.org/controls/implementation-groups> , <https://www.cisecurity.org/insights/white-papers/guide-to-asset-classes-cis-critical-security-controls-v8-1> ;
	skos:definition "A LinkML model of the structure of the CIS Critical Security Controls (CIS Controls), Version 8.1, which the Center for Internet Security (CIS) publishes. It models the Controls and the Safeguards of each Control. For each Safeguard it records the asset class, the security function and the Implementation Groups that include it. It names each Control and Safeguard by its number and carries none of CIS's text." ;
	skos:note "CIS licenses the CIS Controls under CC BY-NC-ND 4.0 and requires its prior approval for commercial use, while this schema is Apache-2.0. So the schema carries no CIS text: none of the guide's titles, descriptions, overviews or explanations. The descriptions here are this project's own words, and so are the title and description that src/cis_controls/data/cis-controls-8.1.2.yaml gives each Control and Safeguard, written from what each requires. The text slots, title and description, are optional and hold text their user has the right to use; NOTICE states the position." , "The edition holds 18 Controls and 153 Safeguards. Implementation Group 1 holds 56 of the Safeguards, Implementation Group 2 adds 74 to make 130, and Implementation Group 3 adds the last 23, so it holds all 153. CIS's pages on the CIS Controls list and on each Implementation Group state these numbers." , "The version is the label that the pages of CIS's guide carry for its revision of March 2025. CIS's site calls the edition Version 8.1. The guide's change log names two minor revisions of it, v8.1.1 in August 2024 and v8.1.2 in March 2025. They corrected small errors, among them the security function of two Safeguards. The source is CIS's page for Version 8.1. scripts/check_upstream_release.py holds the same pins and reports when CIS's pages name a newer version." ;
	cis_controls:cis_site_version "8.1" ;
	cis_controls:pages_read_on "2026-10-30" ;
	cis_controls:revision_date "2025-03" .
cis_controls:CisAssetClass\#DATA dcterms:title "Data" ;
	a owl:Class ;
	rdfs:label "DATA" ;
	rdfs:subClassOf cis_controls:CisAssetClass ;
	skos:definition "The information the enterprise holds, uses and moves." .
cis_controls:CisAssetClass\#DEVICES dcterms:title "Devices" ;
	a owl:Class ;
	rdfs:label "DEVICES" ;
	rdfs:subClassOf cis_controls:CisAssetClass ;
	skos:definition "The enterprise's hardware, wherever it runs." .
cis_controls:CisAssetClass\#DOCUMENTATION dcterms:title "Documentation" ;
	a owl:Class ;
	rdfs:label "DOCUMENTATION" ;
	rdfs:subClassOf cis_controls:CisAssetClass ;
	skos:definition "The enterprise's written governance, such as its policies and procedures." .
cis_controls:CisAssetClass\#NETWORK dcterms:title "Network" ;
	a owl:Class ;
	rdfs:label "NETWORK" ;
	rdfs:subClassOf cis_controls:CisAssetClass ;
	skos:definition "How the enterprise's devices connect, and how its networks are laid out." .
cis_controls:CisAssetClass\#SOFTWARE dcterms:title "Software" ;
	a owl:Class ;
	rdfs:label "SOFTWARE" ;
	rdfs:subClassOf cis_controls:CisAssetClass ;
	skos:definition "The programs and systems that run on the enterprise's devices." .
cis_controls:CisAssetClass\#USERS dcterms:title "Users" ;
	a owl:Class ;
	rdfs:label "USERS" ;
	rdfs:subClassOf cis_controls:CisAssetClass ;
	skos:definition "The people and accounts with access to the enterprise's assets." .
cis_controls:CisAssetClass a owl:Class ;
	rdfs:label "CisAssetClass" ;
	rdfs:seeAlso <https://www.cisecurity.org/insights/white-papers/guide-to-asset-classes-cis-critical-security-controls-v8-1> ;
	owl:unionOf _:c14n26 ;
	skos:definition "One of the classes of enterprise asset that the CIS Controls sort their Safeguards by. Each Safeguard is about one class." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> ;
	skos:note "CIS revised the classes, and which Safeguard is about which, in Version 8.1. CIS's guide divides each class further, but a Safeguard names only the class." ;
	linkml:permissible_values cis_controls:CisAssetClass\#DATA , cis_controls:CisAssetClass\#DEVICES , cis_controls:CisAssetClass\#DOCUMENTATION , cis_controls:CisAssetClass\#NETWORK , cis_controls:CisAssetClass\#SOFTWARE , cis_controls:CisAssetClass\#USERS .
cis_controls:CisControl a owl:Class ;
	rdfs:label "CisControl" ;
	rdfs:seeAlso <https://www.cisecurity.org/controls/cis-controls-list> ;
	rdfs:subClassOf _:c14n1 , _:c14n21 , _:c14n29 , _:c14n3 , _:c14n31 , _:c14n37 , _:c14n38 , _:c14n48 , _:c14n55 , _:c14n6 , _:c14n7 ;
	skos:broadMatch oscal:Group ;
	skos:definition "One of the CIS Controls: a group of Safeguards on one subject, named by its number, such as Control 4." ;
	skos:exactMatch cis_controls:Control ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> .
cis_controls:CisControls a owl:Class ;
	rdfs:label "CisControls" ;
	rdfs:seeAlso <https://www.cisecurity.org/controls/cis-controls-list> ;
	rdfs:subClassOf _:c14n27 , _:c14n33 , _:c14n40 , _:c14n42 , _:c14n45 ;
	skos:broadMatch oscal:Catalog ;
	skos:definition "One edition of the CIS Controls as a whole: its Controls, each holding its Safeguards." ;
	skos:exactMatch cis_controls:Controls ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> .
cis_controls:CisImplementationGroup\#IG1 dcterms:title "Implementation Group 1" ;
	a owl:Class ;
	rdfs:label "IG1" ;
	rdfs:subClassOf cis_controls:CisImplementationGroup ;
	skos:definition "The first group, where every enterprise starts." .
cis_controls:CisImplementationGroup\#IG2 dcterms:title "Implementation Group 2" ;
	a owl:Class ;
	rdfs:label "IG2" ;
	rdfs:subClassOf cis_controls:CisImplementationGroup ;
	skos:definition "The second group, which adds Safeguards to the first." .
cis_controls:CisImplementationGroup\#IG3 dcterms:title "Implementation Group 3" ;
	a owl:Class ;
	rdfs:label "IG3" ;
	rdfs:subClassOf cis_controls:CisImplementationGroup ;
	skos:definition "The third group, which adds the rest and so holds every Safeguard." .
cis_controls:CisImplementationGroup a owl:Class ;
	rdfs:label "CisImplementationGroup" ;
	rdfs:seeAlso <https://www.cisecurity.org/controls/implementation-groups> ;
	owl:unionOf _:c14n22 ;
	skos:definition "One of the three Implementation Groups, CIS's tiers for deciding which Safeguards an enterprise puts in place first. Each group includes every Safeguard of the groups before it." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> ;
	linkml:permissible_values cis_controls:CisImplementationGroup\#IG1 , cis_controls:CisImplementationGroup\#IG2 , cis_controls:CisImplementationGroup\#IG3 .
cis_controls:CisSafeguard a owl:Class ;
	rdfs:label "CisSafeguard" ;
	rdfs:seeAlso <https://www.cisecurity.org/controls/cis-controls-list> ;
	rdfs:subClassOf _:c14n12 , _:c14n14 , _:c14n19 , _:c14n2 , _:c14n20 , _:c14n23 , _:c14n30 , _:c14n32 , _:c14n36 , _:c14n39 , _:c14n4 , _:c14n41 , _:c14n44 , _:c14n49 , _:c14n51 , _:c14n52 , _:c14n53 , _:c14n54 , _:c14n9 ;
	skos:broadMatch oscal:Control ;
	skos:definition "One Safeguard of a Control: a single action an enterprise takes, named by its Control's number and its own, such as Safeguard 4.1." ;
	skos:exactMatch cis_controls:Safeguard ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> .
cis_controls:CisSecurityFunction\#DETECT dcterms:title "Detect" ;
	a owl:Class ;
	rdfs:label "DETECT" ;
	rdfs:subClassOf cis_controls:CisSecurityFunction ;
	skos:definition "The CSF 2.0 function DETECT." ;
	cis_controls:csf_function_id "DE" .
cis_controls:CisSecurityFunction\#GOVERN dcterms:title "Govern" ;
	a owl:Class ;
	rdfs:label "GOVERN" ;
	rdfs:subClassOf cis_controls:CisSecurityFunction ;
	skos:definition "The CSF 2.0 function GOVERN." ;
	cis_controls:csf_function_id "GV" .
cis_controls:CisSecurityFunction\#IDENTIFY dcterms:title "Identify" ;
	a owl:Class ;
	rdfs:label "IDENTIFY" ;
	rdfs:subClassOf cis_controls:CisSecurityFunction ;
	skos:definition "The CSF 2.0 function IDENTIFY." ;
	cis_controls:csf_function_id "ID" .
cis_controls:CisSecurityFunction\#PROTECT dcterms:title "Protect" ;
	a owl:Class ;
	rdfs:label "PROTECT" ;
	rdfs:subClassOf cis_controls:CisSecurityFunction ;
	skos:definition "The CSF 2.0 function PROTECT." ;
	cis_controls:csf_function_id "PR" .
cis_controls:CisSecurityFunction\#RECOVER dcterms:title "Recover" ;
	a owl:Class ;
	rdfs:label "RECOVER" ;
	rdfs:subClassOf cis_controls:CisSecurityFunction ;
	skos:definition "The CSF 2.0 function RECOVER." ;
	cis_controls:csf_function_id "RC" .
cis_controls:CisSecurityFunction\#RESPOND dcterms:title "Respond" ;
	a owl:Class ;
	rdfs:label "RESPOND" ;
	rdfs:subClassOf cis_controls:CisSecurityFunction ;
	skos:definition "The CSF 2.0 function RESPOND." ;
	cis_controls:csf_function_id "RS" .
cis_controls:CisSecurityFunction a owl:Class ;
	rdfs:label "CisSecurityFunction" ;
	rdfs:seeAlso <https://www.cisecurity.org/controls/v8-1> ;
	owl:unionOf _:c14n34 ;
	skos:definition "The security function a Safeguard serves. The values are the six functions of the NIST Cybersecurity Framework (CSF) 2.0, to which Version 8.1 aligned the CIS Controls." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> ;
	skos:note "lmodel/nist-csf-v2 v0.1.0 models a CSF function as an instance of its class CsfFunction, IRI nist_csf_v2:Function, named by the two letters in its csf_function_id. It publishes no IRI for each function, so the values carry no meaning; each value's csf_function_id annotation gives the letters, and the enum names the class in related_mappings." ;
	skos:relatedMatch nist_csf_v2:Function ;
	linkml:permissible_values cis_controls:CisSecurityFunction\#DETECT , cis_controls:CisSecurityFunction\#GOVERN , cis_controls:CisSecurityFunction\#IDENTIFY , cis_controls:CisSecurityFunction\#PROTECT , cis_controls:CisSecurityFunction\#RECOVER , cis_controls:CisSecurityFunction\#RESPOND .
cis_controls:cis_control_id a owl:DatatypeProperty ;
	rdfs:label "cis_control_id" ;
	rdfs:range xsd:string ;
	skos:definition "The Control's identifier, its number, such as 4." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> ;
	skos:note "The identifier is CIS's own number, so data joins with CIS's guide and with the crosswalks that cite it without a translation. It is a string, so quote it in YAML: YAML reads an unquoted 4 as a number and an unquoted 1.10 as the number 1.1. The validator rejects either as not a string, but a file loaded into the generated dataclasses without validation would turn 1.10 into 1.1." .
cis_controls:cis_controls a owl:ObjectProperty ;
	rdfs:label "cis_controls" ;
	skos:definition "The Controls, in CIS's order." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> .
cis_controls:cis_safeguard_id a owl:DatatypeProperty ;
	rdfs:label "cis_safeguard_id" ;
	rdfs:range xsd:string ;
	skos:definition "The Safeguard's identifier, its number, such as 4.1." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> ;
	skos:note "It starts with the number of the Control that holds the Safeguard. The validator cannot check that against the Control a Safeguard is listed under; tests/test_data.py checks it over the examples." .
cis_controls:cis_version a owl:DatatypeProperty ;
	rdfs:label "cis_version" ;
	skos:definition "The edition, as CIS numbers it, such as 8.1, or the revision the guide's pages carry, such as 8.1.2." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> .
cis_controls:control_safeguards a owl:ObjectProperty ;
	rdfs:label "control_safeguards" ;
	skos:definition "The Safeguards of the Control. A knowledge bundle relates a Safeguard to its Control with isPartOf instead." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> .
cis_controls:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	skos:definition "What the Control or Safeguard means to its user, in words its user has the right to use." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> ;
	skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." .
cis_controls:safeguard_asset_class a owl:ObjectProperty ;
	rdfs:label "safeguard_asset_class" ;
	skos:definition "The class of enterprise asset the Safeguard is about." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> .
cis_controls:safeguard_implementation_groups a owl:ObjectProperty ;
	rdfs:label "safeguard_implementation_groups" ;
	skos:definition "The Implementation Groups that include the Safeguard." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> ;
	skos:note "The groups are cumulative: a Safeguard in IG1 is in IG2 and IG3 too, and one in IG2 is in IG3. The schema states the part of that rule the validator can check, that every Safeguard is in IG3. The JSON Schema that LinkML 1.12.1 generates drops the rest, so a list of IG1 and IG3 without IG2 passes the validator. tests/test_data.py checks the whole rule over the examples." .
cis_controls:safeguard_security_function a owl:ObjectProperty ;
	rdfs:label "safeguard_security_function" ;
	skos:definition "The security function the Safeguard serves, one of the six functions of the NIST Cybersecurity Framework (CSF) 2.0." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> .
cis_controls:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	skos:definition "A name for the Control or Safeguard, in words its user has the right to use." ;
	skos:inScheme <https://w3id.org/lmodel/cis-controls> ;
	skos:note "CIS's own names for the Controls and Safeguards are CIS's text under CC BY-NC-ND 4.0, so the schema's examples leave them out, and the edition file names each element in this project's words." , "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." .
